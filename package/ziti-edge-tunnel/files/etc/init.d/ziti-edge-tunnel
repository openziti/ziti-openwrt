#!/bin/sh /etc/rc.common
# Copyright (C) 2026 OpenZiti contributors
# Apache-2.0
#
# procd init for ziti-edge-tunnel.
#
# Single-process, multi-identity model: ZET loads ALL .json files in
# /etc/ziti/identities/ via --identity-dir. Per-identity disable is
# done by renaming <name>.json to <name>.json.disabled (ZET ignores
# files not ending in .json). No symlink staging; nothing in /tmp;
# ZET's runtime state file (config.json next to identities) lives on
# overlay and survives reboot.

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/ziti-edge-tunnel
IDENTITY_DIR=/etc/ziti/identities
GUARD=/usr/libexec/ziti-boot-guard

# Map UCI log_level (TRACE/DEBUG/INFO/WARN/ERROR) to ZET --verbose 0..6.
verbosity_for() {
	case "$1" in
		TRACE|trace) echo 6 ;;
		DEBUG|debug) echo 4 ;;
		INFO|info)   echo 3 ;;
		WARN|warn|WARNING|warning) echo 2 ;;
		ERROR|error) echo 1 ;;
		*) echo 3 ;;
	esac
}

start_service() {
	local enabled log_level dns_upstream
	config_load ziti
	config_get_bool enabled main enabled 1
	config_get      log_level main log_level INFO
	config_get      dns_upstream main dns_upstream ''

	[ "$enabled" = "1" ] || {
		logger -t ziti "ziti.main.enabled=0, not starting"
		return 0
	}

	# Refuse to start with zero identities -- ZET would exit and trigger
	# the procd respawn loop. User must enroll first via LuCI or CLI.
	if [ -z "$(ls "$IDENTITY_DIR"/*.json 2>/dev/null)" ]; then
		logger -t ziti "no .json files under $IDENTITY_DIR; not starting (enroll an identity first)"
		return 0
	fi

	# Boot safeguard (full-tunnel only, ziti.main.boot_verify=1): refresh the
	# controller pins in /etc/hosts and prove a controller is reachable BEFORE
	# we start ZET. If it is not reachable the tunnel cannot come up, so the
	# guard falls open (restores lan->wan, flushes any stray /1 routes) and we
	# do NOT start -- never black-hole the wifi over a dead controller.
	if [ -x "$GUARD" ]; then
		if ! "$GUARD" preflight; then
			logger -t ziti "boot-guard preflight failed; not starting (fell back to direct internet)"
			return 0
		fi
	fi

	local v
	v=$(verbosity_for "$log_level")

	procd_open_instance ziti-edge-tunnel
	procd_set_param command "$PROG" run \
		--identity-dir "$IDENTITY_DIR" \
		--verbose "$v"
	# Optional: forward non-Ziti-service DNS to this resolver (e.g. a home
	# pi-hole reached over the tunnel). Only affects names in the Ziti domains
	# dnsmasq hands to ZET; general DNS never touches this.
	[ -n "$dns_upstream" ] && procd_append_param command --dns-upstream "$dns_upstream"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/ziti
	procd_close_instance

	# Post-start + mid-session verification is handled by the separate ziti-guard
	# service (continuous watchdog), not here -- it must outlive this service so
	# its own fall-open can stop ZET without killing the recovery process. Make
	# sure it is running so a fresh start is watched immediately.
	[ -x /etc/init.d/ziti-guard ] && /etc/init.d/ziti-guard enabled 2>/dev/null && /etc/init.d/ziti-guard start >/dev/null 2>&1

	# Program dnsmasq to hand the configured Ziti/home domains to ZET's resolver.
	# Additive + idempotent; leaves dnsmasq's default upstream untouched, so it
	# cannot cause a general DNS outage even if ZET never comes up.
	[ -x "$GUARD" ] && "$GUARD" dns-sync >/dev/null 2>&1
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "ziti"
}
