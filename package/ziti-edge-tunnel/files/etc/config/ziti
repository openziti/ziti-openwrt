#
# OpenZiti UCI config.
#
# Tunable globals live under config ziti 'main'. Per-identity disable
# is done by renaming the identity JSON to <name>.json.disabled in
# /etc/ziti/identities/ -- the init script only loads files ending in
# .json. The config identity sections below are informational; the
# init script does not iterate them today.
#

config ziti 'main'
	option enabled '1'
	option log_level 'INFO'
	# Boot safeguards for FULL-tunnel mode. When boot_verify=1 the router will,
	# on every boot in full mode: refresh controller pins in /etc/hosts, refuse
	# to start the tunnel if no controller is reachable, and after start verify
	# egress actually returns data -- falling back to direct internet on any
	# failure so the wifi never black-holes. Ignored in split mode.
	option boot_verify '1'
	# After this many consecutive failed boots, boot-autostart is disabled.
	option max_boot_failures '3'
	# Optional: pin the expected egress IP (your exit endpoint's public IP). If
	# set, verification also asserts traffic left from there, proving it tunneled
	# rather than leaked to the local uplink. Leave empty to skip the assertion.
	# option verify_expect_ip '203.0.113.10'
	# Post-start verification window: verify_tries * verify_interval seconds.
	# option verify_tries '12'
	# option verify_interval '5'
	# Continuous watchdog (ziti-guard service): in full mode it re-checks egress
	# through the tunnel every watchdog_interval seconds and, after watchdog_fails
	# consecutive failures, falls back to direct internet -- so an exit that dies
	# mid-session cannot black-hole the wifi. watchdog_grace delays the first
	# check after a (re)start so ZET has time to connect.
	# option watchdog_interval '10'
	# option watchdog_fails '3'
	# option watchdog_grace '20'
	# --- OpenZiti DNS integration (optional; bulletproof by design) ---
	# dnsmasq ALWAYS keeps its own direct default resolver. These options only
	# ADD per-domain forwarding of the named domains to ZET's resolver. If ZET is
	# down, only these domains fail to resolve; all other DNS is unaffected --
	# there is no way for this to cause a general DNS outage.
	# Domains handed to ZET (repeat for several; e.g. your overlay + home domain):
	# list ziti_dns_domains 'ziti'
	# list ziti_dns_domains 'parkplace-via-dhcp'
	# Where ZET forwards names that are NOT Ziti services -- e.g. your home DNS
	# server, reached over the tunnel so home names resolve as-at-home. Leave
	# empty for ZET's own default.
	# option dns_upstream '192.168.1.5'
	# ZET resolver address dnsmasq forwards the domains to. The tunneler puts its
	# resolver at the .2 of the DNS range (100.64.0.2 for the default
	# 100.64.0.0/10). Change only if you set a custom dns-ip-range.
	# option dns_resolver_ip '100.64.0.2'

# Example -- gets written automatically by the LuCI Identities tab on
# successful enroll, OR you can hand-edit after a CLI enroll:
#
# config identity
#	option name 'home'
#	option file '/etc/ziti/identities/home.json'
#	option enabled '1'
